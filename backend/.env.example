# ==========================================
# CONFIGURAÇÕES DO AGROSKAN BACKEND
# ==========================================
PORT=5000
NODE_ENV=production
DATABASE_URL=postgres://postgres:@AgroskanPostgres2026!@localhost:5432/agroskan
JWT_SECRET=@AgroskanSecretKey2026Drone!
APP_URL=https://agroskan.com.br

# ==========================================
# CONFIGURAÇÃO DO SERVIÇO DE E-MAIL (BREVO)
# ==========================================
# OPÇÃO 1: Brevo REST API v3 (Recomendado - não depende de portas de firewall SMTP)
# Obtenha sua chave no painel Brevo em: Configurações -> SMTP e API -> Chaves de API
BREVO_API_KEY=sua_chave_api_brevo_aqui

# OPÇÃO 2: Brevo SMTP (Alternativa padrão do Nodemailer)
# Obtenha no painel Brevo em: Configurações -> SMTP e API -> Chaves SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu_email_login_brevo@exemplo.com
SMTP_PASS=sua_chave_smtp_brevo_aqui

# E-mail e remetente de envio (deve estar verificado no painel da Brevo)
SMTP_FROM=suporte@agroskan.com.br
