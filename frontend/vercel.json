{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://relatorio-gama-backend.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://relatorio-gama-backend.vercel.app/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads).*[^/])",
      "destination": "/index.html"
    }
  ]
}
